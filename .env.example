# Copy this file to .env and fill in your values. Never commit .env.
# (Master Implementation Specification §5.1)

# Google Gemini API key. If absent, the AI feature is disabled gracefully
# and the dashboard uses the offline rule-based fallback analysis.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: overrides config.GEMINI_MODEL_DEFAULT.
# GEMINI_MODEL=gemini-2.0-flash
